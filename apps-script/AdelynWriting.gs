/**
 * The ELA Pastry Kitchen — Adelyn's Writing Workshop, Weeks 1-4
 * ("Sentence Play" — the only phase fully written up so far).
 *
 * Adds net-new Schedule rows for Adelyn's "writing" subject, converted
 * from Adelyns_Writing_Workshop_Year1_v3.docx. Does NOT touch
 * setupSheets(), Month1Weeks2to5.gs, AdelynVocabReading.gs,
 * AdelynSpelling.gs, AdelynGrammarUnit1.gs, or any Kenley rows — purely
 * additive, and only touches Adelyn's placeholder "writing" row.
 *
 * THIS IS A PARTIAL SEED, BY DESIGN — NOT AN OVERSIGHT. The source
 * document itself only has detailed weekly sessions written for Weeks
 * 1-4 ("Sentence Play"). Weeks 5-14 continue that same sentence-level
 * phase but are explicitly marked "to be written once you let me know
 * how this month goes" — the curriculum is meant to be built adaptively
 * around how Adelyn actually responds to these first four weeks, not
 * front-loaded. Weeks 15-22 ("Building the Paragraph") exist only as a
 * one-paragraph-per-week preview table in the source doc, not full
 * sessions. Weeks 23-36 aren't detailed at all yet. Re-open the source
 * docx for Weeks 5+ once Kristina has more of it written.
 *
 * Content structure per week (each week is fundamentally a PARENT-LED,
 * mostly-oral session — Adelyn's own screen time is just the last step):
 *   A "read" task carrying the week's full session plan pretty much
 *     verbatim from the source doc — the "Hi Adelyn!" callout is written
 *     directly to her, but the rest (Before You Sit Down, Step-by-Step
 *     Session, Playful Practice) is written in second person to the
 *     parent ("say something like...", "ask her..."). It's included as-is
 *     rather than rewritten into kid-voice, the same way Kenley's lesson
 *     content sometimes carries parent-facing asides (e.g. RULE BREAKER
 *     notes) — Adelyn seeing "here's what to say to her" is harmless, and
 *     rewriting it would risk losing fidelity to the actual session plan
 *     Kristina needs to run.
 *   A "reflection" task for "Adelyn's Turn — Independent Writing" — her
 *     actual turn to write, offered as 1-3 open-ended choices exactly as
 *     the doc presents them. Deliberately NO fixed answer key: this
 *     program's whole philosophy is that there is no single correct
 *     sentence or paragraph. The task's sampleAnswer field instead
 *     carries two things for the parent-review flow: (1) a short
 *     illustrative example Claude wrote for this build — explicitly
 *     labeled as an example of the shape/level to expect, not a target
 *     to match — since the source doc's own "outfits" examples are
 *     addressed to the parent to read aloud DURING the session, not
 *     meant as a grading rubric afterward; and (2) that week's "Coaching
 *     Notes for You" verbatim, framed explicitly as coaching guidance
 *     rather than a model answer. Together these are useful in the
 *     Approve/Refire flow (what to praise, what NOT to correct, what's a
 *     false alarm vs. a real stuck point) without implying there's a
 *     "right" response to
 *     grade against.
 *
 * Run seedAdelynWriting_() ONCE from the function dropdown, after
 * setupSheets() has already been run at least once. It's idempotent: if
 * it detects task_id "awl1" already in the Schedule sheet, it assumes
 * this has already run and does nothing. It also removes Adelyn's
 * original single placeholder row for "writing" ("aw1" waiting-shell —
 * note the real content below reuses "aw1" for Week 1's actual
 * independent-writing task, so that old placeholder is deleted by label
 * match before the new rows are added, to avoid an id collision).
 */

function seedAdelynWriting_() {
  var sh = getSheet_('Schedule');
  var existing = sheetToObjects_(sh);

  // Delete EVERY existing Adelyn row for writing — old placeholder, an
  // older version of this same content, anything — and rebuild fresh from
  // ADELYN_WRITING_WEEKS below. Safe to re-run any time this content is
  // updated; it always fully replaces rather than skipping.
  var toDelete = existing.filter(function (r) {
    return r.student === 'adelyn' && r.subject_key === 'writing';
  });
  toDelete.sort(function (a, b) { return b._row - a._row; }).forEach(function (r) { sh.deleteRow(r._row); });

  var rows = [];
  function addTasks(subjectKey, subjectName, subjectTag, weekNumber, tasks) {
    tasks.forEach(function (t) {
      var content = {};
      Object.keys(t).forEach(function (k) {
        if (['id', 'label', 'type', 'dynamic', 'termFinal', 'monthlyTest'].indexOf(k) === -1) content[k] = t[k];
      });
      rows.push([
        'adelyn', subjectKey, subjectName, subjectTag, weekNumber,
        t.id, t.type, t.label, JSON.stringify(content),
        t.dynamic || '', !!t.termFinal, !!t.monthlyTest
      ]);
    });
  }

  ADELYN_WRITING_WEEKS.forEach(function (week) {
    Object.keys(week.subjects).forEach(function (subjectKey) {
      var subj = week.subjects[subjectKey];
      addTasks(subjectKey, subj.name, subj.tag, week.week_number, subj.tasks);
    });
  });

  var headers = SHEET_HEADERS.Schedule;
  sh.getRange(sh.getLastRow() + 1, 1, rows.length, headers.length).setValues(rows);
  var doneMsg = 'Added ' + rows.length + ' new Schedule rows for Adelyn — Writing, Weeks 1-4 (Sentence Play).';
  try { SpreadsheetApp.getUi().alert(doneMsg); } catch (e) { Logger.log(doneMsg); }
}

// ---------- Content ----------

var ADELYN_WRITING_WEEKS = [{week_number:1,subjects:{writing:{name:'Writing',tag:'Sentence Play · Week 1',tasks:[{id:'awl1',label:'Week 1: Warming Up — One Sentence, Lots of Outfits',type:'read',content:'<div class="lesson-text"><p><b>Week 1: Warming Up — One Sentence, Lots of Outfits</b></p><p style="opacity:.7;font-size:0.78rem;">Time: 15–20 minutes, 2–3 times this week</p><p>Here\'s a secret: grown-up authors play dress-up with their sentences all the time. They start with a plain idea — <i>a dog ran</i> — and then they dress it up until it sounds like THEM.</p><p>A sentence like "The dog ran" is already totally correct — nothing wrong with it! But it\'s a little plain, like a stick figure with no face or clothes. You can dress up ANY plain sentence with describing words, and there are dozens of good outfits for the same sentence — not just one.</p><p>Look at these three different outfits for the exact same sentence:</p><table class="vocab-table"><tr><td>The dog ran. <i>(plain)</i></td></tr><tr><td>The fluffy, brown dog ran. <i>(how it looked)</i></td></tr><tr><td>The tired, muddy dog ran. <i>(how it felt)</i></td></tr><tr><td>The silly, spotted dog ran. <i>(just for fun!)</i></td></tr></table><p>This week isn\'t about finding the "right" describing words. It\'s about trying on a few and picking the ones that sound most like something YOU would say.</p></div>',parentNotes:'<p><b>Before you sit down</b></p><ul><li>You need: a pencil and a few minutes, that\'s it — everything happens right in the app now.</li><li>You do not need to know grammar terms to teach this well. If she asks "what\'s an adjective?" you can simply say "a word that describes something — like tall, wobbly, or delicious." That\'s enough.</li><li>Your only job this week is to react with genuine delight to her word choices. There is no wrong answer as long as the sentence still makes sense.</li></ul><p><b>Warm-up to play together first (away from the screen)</b></p><p>Before she gets to the guided-practice step in the app, play this out loud first (3–5 min, no screens): say a plain sentence and toss it back and forth, each of you adding one describing word at a time, like a game of catch. Try: "I\'m going to say a plain, boring sentence, and we\'re going to take turns dressing it up. Ready? \'The ball rolled.\' Your turn — what\'s one word we could add?" If she says "bouncy," respond with real enthusiasm ("Oh, I can SEE it bouncing now!"), then add your own word, and hand it back to her. Do 2–3 rounds, then try a second plain sentence.</p><p><b>Playful practice (optional, if she\'s having fun)</b></p><p>"Sentence Dress-Up Game" (optional, if she\'s having fun): write 4–5 plain sentences about things Adelyn loves — gymnastics, cooking, a place you\'ve traveled — on separate slips of paper. She picks one at random and has 30 seconds to say the fanciest, silliest, or most beautiful dressed-up version she can think of, out loud. No writing required — pure oral play. Example plain sentences: "The gymnast flipped." "The soup simmered." "The plane landed." "The market buzzed."</p>'},{id:'awg1',label:'Guided Practice',type:'reflection',prompt:'Say each sentence out loud first — dress it up out loud before you type anything. Then type your favorite dressed-up version of each one below.<ul><li>The dog ran.</li><li>The girl practiced.</li><li>The chef cooked dinner.</li><li>The gymnast landed.</li><li>The book fell.</li></ul>Try asking yourself: What did it look like? How many were there? What sounds like something YOU would say?',sampleAnswer:'<p>Ask a concrete, curious question rather than "add an adjective" — questions are far more inviting than instructions: "What did it look like?" "How many were there?" "What would make this sound more like something YOU would write?"</p>'},{id:'aw1',label:'Your Turn — Independent Writing',type:'reflection',prompt:'Pick ONE and write it right here:<ul><li>Write 3 plain sentences about something from today, then dress each one up.</li><li>Write 3 already-dressed-up sentences about your favorite gymnastics move, straight from your imagination.</li><li>Write about anything at all — as long as at least 2 of your sentences have describing words you\'re proud of.</li></ul>',sampleAnswer:'<i>An illustrative example only (Claude wrote this to show the shape/level a good answer might take — it\'s not a target, and her own answer succeeding should look nothing like it if her voice takes it somewhere different):</i><br>The gymnast flipped. → <i>The fearless, sweaty gymnast flipped.</i><br>The soup simmered. → <i>The spicy, bubbling soup simmered.</i><br>The plane landed. → <i>The huge, silver plane landed.</i><br><br><b>Coaching note for you</b> (not an answer key — there\'s no single correct answer here): The single biggest skill you\'re building this week isn\'t Adelyn\'s — it\'s yours: reacting to her writing with specific delight instead of correction. Try to say the exact words or phrases you loved out loud ("I love that you called it a wobbly cartwheel — I can totally picture it!") rather than a generic "good job." Resist fixing spelling or grammar during writing time this week — that\'s what her spelling and grammar lessons are for. If she writes something wildly different from the examples (a poem, a silly list, a made-up creature), that\'s a win, not a detour — the goal is a sentence SHE is proud of, not a sentence that matches a template. If she gets stuck and says "I don\'t know what to add," that\'s your cue to ask a concrete sensory question (What did it look/sound/feel like?) rather than supplying the word yourself.'}]}}},{week_number:2,subjects:{writing:{name:'Writing',tag:'Sentence Play · Week 2',tasks:[{id:'awl2',label:'Week 2: Action Words With Personality',type:'read',content:'<div class="lesson-text"><p><b>Week 2: Action Words With Personality</b></p><p style="opacity:.7;font-size:0.78rem;">Time: 15–20 minutes, 2–3 times this week</p><p>"Went" is one very overworked word — it gets used for walking, running, flying, sneaking, ALL of it. Let\'s give "went" a little vacation this week.</p><p>Instead of "Adelyn went to the mat," how did she actually get there? Did she skip? Race? Tiptoe? Cartwheel the whole way there?</p><p>Read these three versions of the same sentence — which one can you "feel" the most?</p><table class="vocab-table"><tr><td>Adelyn went to the mat.</td></tr><tr><td>Adelyn sprinted eagerly to the mat.</td></tr><tr><td>Adelyn crept nervously to the mat.</td></tr></table><p>Notice that little extra word at the end — eagerly, nervously — it tells us HOW she moved, and it completely changes the feeling of the sentence, even though the verb changed too.</p></div>',parentNotes:'<p><b>Before you sit down</b></p><ul><li>Start by reading 1–2 of her dressed-up sentences from Week 1 back to her. Starting with a win builds momentum.</li><li>No new vocabulary required from you. If she asks what an "adverb" is, "a word that tells how, when, or where something happened" is plenty.</li></ul><p><b>Warm-up to play together first (away from the screen)</b></p><p>Before the guided-practice step, play "Ban the Boring Verb" out loud (3–5 min, no screens): say a sentence using "went" or "got," and ask her for three different, more specific verbs that could replace it — collect all three before judging any of them. Try: "Adelyn went to the kitchen. Give me three different words we could use instead of \'went\' — they can be totally different moods, silly or serious." Have some in your back pocket if she gets stuck (offer only if truly stuck): tiptoed, raced, wandered, skipped, marched.</p><p><b>Playful practice (optional, if she\'s having fun)</b></p><p>"Verb Charades" (optional): act out walking five different ways (tiptoeing, marching, stomping, sneaking, skipping) and have Adelyn name the verb for each. Then flip it — she acts, you name it. This builds a bank of specific verbs without any writing at all.</p>'},{id:'awg2',label:'Guided Practice',type:'reflection',prompt:'Say each sentence out loud two or three different ways before you type your favorite. Give each one a punchier, more specific verb.<ul><li>Adelyn went to the mat.</li><li>Kenley made the soup.</li><li>The cat was on the chair.</li><li>Adelyn did a flip.</li><li>The family went to the market.</li></ul>Try asking yourself: How do you think she actually moved? Was she in a hurry, or taking her time? What\'s a funnier way to say that?',sampleAnswer:'<p>Prompting questions to offer if she\'s stuck: "How do you think she actually moved?" "Was she in a hurry, or taking her time?" "What\'s a funnier way to say that?"</p>'},{id:'aw2',label:'Your Turn — Independent Writing',type:'reflection',prompt:'Pick ONE and write it right here:<ul><li>Pick 3 sentences from last week and give each one a punchier, more specific verb.</li><li>Write 3 brand-new sentences about cooking or gymnastics, choosing your verb first, on purpose, before anything else.</li></ul>',sampleAnswer:'<i>An illustrative example only (Claude wrote this to show the shape/level a good answer might take — it\'s not a target, and her own answer succeeding should look nothing like it if her voice takes it somewhere different):</i><br>Adelyn went to the mat. → <i>Adelyn cartwheeled to the mat.</i><br>Kenley made the soup. → <i>Kenley whisked the soup.</i><br>The cat was on the chair. → <i>The cat curled up on the chair.</i><br><br><b>Coaching note for you</b> (not an answer key — there\'s no single correct answer here): If Adelyn keeps choosing –ly adverbs every single time (quickly, slowly, happily), that\'s completely fine for now — sentence-opener variety and reducing adverb reliance is a much later-year skill, not this week\'s job. Watch for verb swaps that no longer fit the sentence\'s meaning (e.g., \'went\' → \'flew\' only makes sense if she\'s imagining something that can fly). If it happens, get curious rather than correcting: \'Ooh, tell me about that — is she flying?\' Sometimes the surprising answer is more interesting than the \'accurate\' one, and that\'s voice, not error. Keep celebrating specific word choices out loud.'}]}}},{week_number:3,subjects:{writing:{name:'Writing',tag:'Sentence Play · Week 3',tasks:[{id:'awl3',label:'Week 3: Painting the Scene — Where and When',type:'read',content:'<div class="lesson-text"><p><b>Week 3: Painting the Scene — Where and When</b></p><p style="opacity:.7;font-size:0.78rem;">Time: 15–20 minutes, 2–3 times this week</p><p>Close your eyes for a second. I\'m going to say a sentence, and I want you to tell me: can you actually SEE where this is happening? "Adelyn stretched." ...Can you?</p><p>Now try this one: "Adelyn stretched on the balance beam, just before the judges walked in." Big difference, right?</p><p>This week we\'re building sets for our sentences — a short "where" or "when" phrase that lets a reader picture the whole scene, not just the action.</p><table class="vocab-table"><tr><td>The determined gymnast stretched. <i>(plain)</i></td></tr><tr><td>The determined gymnast stretched on the cool tile floor.</td></tr><tr><td>The determined gymnast stretched before the big competition.</td></tr></table><p>Which one can you picture best, and why? There\'s no wrong answer — "I just like it better" is a totally fine reason.</p></div>',parentNotes:'<p><b>Before you sit down</b></p><ul><li>No grammar terms needed this week — avoid the phrase "prepositional phrase" even if you know it; she\'ll meet that term later, on Grammar Town\'s own schedule, and it\'ll feel like recognizing an old friend rather than new homework.</li><li>If it\'s practical, do this session somewhere with a view — a balcony, a market, a park bench — since "noticing the scene around you" is literally the week\'s skill.</li></ul><p><b>Warm-up to play together first (away from the screen)</b></p><p>Before the guided-practice step, warm up by noticing your real surroundings (3–5 min, oral): wherever you\'re sitting, take turns finishing the sentence "I am sitting..." with a different true place-phrase each time. A word bank to have ready if she\'s stuck for a starter word: in, on, at, near, under, behind, beside, before, after.</p><p><b>Playful practice (optional, if she\'s having fun)</b></p><p>"Postcard Sentences" (optional): since you\'re traveling, this is a natural fit — have Adelyn write 1–2 sentences that could go on a postcard from somewhere you\'ve actually visited, making sure each one names a real place or time ("near the old fountain," "right before sunset").</p>'},{id:'awg3',label:'Guided Practice',type:'reflection',prompt:'These sentences already have describing words and a strong verb — your only job is adding a where/when phrase to finish the scene.<ul><li>The determined gymnast stretched.</li><li>Kenley chopped the ripe mangoes.</li><li>Adelyn practiced her cartwheel.</li><li>The tired travelers rested.</li><li>The warm bread cooled.</li></ul>Try asking yourself: Where do I picture this happening? When do I think this is?',sampleAnswer:'<p>Any reasonable place or time phrase counts as a win — "before breakfast," "in Portugal," and "near the fountain" are all equally correct.</p>'},{id:'aw3',label:'Your Turn — Independent Writing',type:'reflection',prompt:'Pick ONE and write it right here:<ul><li>Write 3 sentences about a favorite place (real or from a trip), making sure every sentence has a where or when phrase.</li><li>Describe your gymnastics gym or your kitchen at home as if you\'re giving someone a tour in sentences.</li></ul>',sampleAnswer:'<i>An illustrative example only (Claude wrote this to show the shape/level a good answer might take — it\'s not a target, and her own answer succeeding should look nothing like it if her voice takes it somewhere different):</i><br>The determined gymnast stretched. → <i>The determined gymnast stretched before the big competition.</i><br>Kenley chopped the ripe mangoes. → <i>Kenley chopped the ripe mangoes on the wooden cutting board.</i><br>The warm bread cooled. → <i>The warm bread cooled by the open window.</i><br><br><b>Coaching note for you</b> (not an answer key — there\'s no single correct answer here): Any reasonable place or time phrase counts as a win — \'before breakfast,\' \'in Portugal,\' and \'near the fountain\' are all equally correct. There is genuinely no single right answer here. This is intentionally not being labeled grammatically yet — that comes later, from Grammar Town, on its own timeline.'}]}}},{week_number:4,subjects:{writing:{name:'Writing',tag:'Sentence Play · Week 4',tasks:[{id:'awl4',label:'Week 4: All the Tools Together',type:'read',content:'<div class="lesson-text"><p><b>Week 4: All the Tools Together — Your First Real Paragraph</b></p><p style="opacity:.7;font-size:0.78rem;">Time: 20–25 minutes, 2–3 times this week</p><p>You\'ve collected three tools so far this month — describing words, lively verbs, and where/when phrases — and today you get to use them ALL at once, like a painter finally using every color in the box.</p><p>There\'s also a bonus fourth tool: your five senses. Instead of telling me a place was "nice," show me what MADE it nice — what did you see there? Hear? Smell?</p><p>Watch how one plain sentence grows when you add one tool at a time:</p><table class="vocab-table"><tr><td>The pot boiled.</td></tr><tr><td>The old pot boiled. <i>(+describing word)</i></td></tr><tr><td>The old, dented pot bubbled. <i>(+lively verb)</i></td></tr><tr><td>The old, dented pot bubbled loudly. <i>(+how)</i></td></tr><tr><td>The old, dented pot bubbled loudly on the stove. <i>(+where)</i></td></tr></table><p>This week you\'ll practice a few sentences using all your tools, then write your very first real paragraph — several sentences about ONE experience, put together.</p></div>',parentNotes:'<p><b>Before you sit down</b></p><ul><li>This is a celebration week, not a test. Frame it that way to Adelyn explicitly: she\'s spent three weeks collecting tools, and now she gets to use all of them at once.</li><li>Pull up her Week 1 answers if you can (Parent view → past weeks) — you\'ll compare them to what she writes this week, and that comparison is the whole point of the month.</li></ul><p><b>Introduce the fifth tool — senses (do this before the Sense Practice step, 3–5 min, oral)</b></p><p>Ask her to describe a place she loves (the gym, the kitchen, a favorite market) using ONLY sense words, no other detail, just to practice the muscle. Try: "Don\'t tell me if it was nice. Tell me: what did it smell like? What did you hear? What did it feel like under your feet?"</p>'},{id:'aws4',label:'Sense Practice',type:'reflection',prompt:'Describe a place you love — the gym, the kitchen, a favorite market — using ONLY your senses. Don\'t tell me if it was "nice." Tell me: what did it smell like? What did you hear? What did it feel like under your feet?',sampleAnswer:'<p>Any specific, genuine sensory detail counts — the goal is practicing the muscle of noticing, not a "correct" answer.</p>'},{id:'awg4',label:'Guided Practice',type:'reflection',prompt:'Say each sentence out loud first, then dress it up using as many of your tools as you can — a describing word, a lively verb, a where/when phrase, and a sense detail if it fits.<ul><li>The market was busy.</li><li>Adelyn landed the jump.</li><li>The soup was ready.</li><li>The plane arrived.</li></ul>Try for at least 3 of your 4 tools on each one.',sampleAnswer:'<p>Look for at least 2–3 of the four tools (describing word, lively verb, where/when, sense detail) per sentence — not all four every time.</p>'},{id:'aw4',label:'Your Turn — Your First Real Paragraph',type:'reflection',prompt:'Write your first real paragraph! Pick ONE experience — a gymnastics class or a trick you\'re working on, cooking or eating a favorite dish, or a place from your travels that stuck in your memory. Write 4–5 fully dressed-up sentences about that ONE thing, right here — not four unrelated sentences, but one little story or description with a beginning, middle, and end feeling to it.',sampleAnswer:'<p><b>The Big Moment — Comparing Week 1 to Week 4:</b> Pull up her very first Week 1 answer and this week\'s paragraph and read them side by side out loud, in her voice if she\'ll read them herself. Try: "Listen to this sentence from three weeks ago, and now listen to this paragraph. You did that. Can you hear how much more I can picture now?" This single conversation — naming her own growth in her own words — matters more at this age than any grade, score, or sticker chart could.</p><p><b>End-of-month checkpoint:</b> Do not expect a formal topic sentence or tidy paragraph structure yet — that\'s the gentler focus starting around Week 15. This month\'s paragraph is allowed to be a loose, joyful string of good sentences about one idea. Keep protecting this time from correction — jot down any grammar/spelling pattern worth addressing for her separate lessons instead of fixing it here.</p>'}]}}}];
